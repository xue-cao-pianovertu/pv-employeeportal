{
  "routes": [
    {
      "route": "/apv-register",
      "rewrite": "/apv-register.html"
    },
    {
      "route": "/login-apv",
      "rewrite": "/login-apv.html"
    },
    {
      "route": "/dashboard-apvadmin",
      "rewrite": "/dashboard-apvadmin.html"
    },
    {
      "route": "/dashboard-student",
      "rewrite": "/dashboard-student.html"
    },
    {
      "route": "/register",
      "rewrite": "/index.html"
    },
    {
      "route": "/login",
      "rewrite": "/login-client.html"
    },
    {
      "route": "/dashboard",
      "rewrite": "/dashboard-client.html"
    },
    {
      "route": "/prospect",
      "rewrite": "/prospect.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/*.{html,js,css,png,jpg,jpeg,svg,ico,woff,woff2}"
    ]
  },
  "globalHeaders": {
    "Cache-Control": "no-store"
  },
  "responseOverrides": {}
}
